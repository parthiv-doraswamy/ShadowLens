# Local-only backend defaults; keep the service bound to loopback.
SHADOWLENS_ENV=development
SHADOWLENS_HOST=127.0.0.1
SHADOWLENS_PORT=8000
SHADOWLENS_API_PREFIX=/api
SHADOWLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local data and first-run bearer token (created with restrictive permissions).
SHADOWLENS_DATA_DIR=.shadowlens
# Optional token path override (defaults to SHADOWLENS_DATA_DIR/access.token).
# SHADOWLENS_TOKEN_FILE=.shadowlens/access.token
# Optional operator-managed override; leave empty for automatic generation.
SHADOWLENS_API_TOKEN=
# Optional database URL override (defaults to SHADOWLENS_DATA_DIR/shadowlens.db).
# SHADOWLENS_DATABASE_URL=sqlite:///.shadowlens/shadowlens.db

# Bounded in-memory event intake.
SHADOWLENS_EVENT_QUEUE_CAPACITY=256
SHADOWLENS_EVENT_WORKERS=1
SHADOWLENS_INGEST_TIMEOUT_SECONDS=1.0

# Structured application log verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL).
SHADOWLENS_LOG_LEVEL=INFO
